        </div>
        <div>
            <h5 class="text-sm/4 font-bold mb-4">Tentang Kami</h5>
            <ul class="space-y-2.5 text-xs/4 text-white/60">
                <li><a href="#" class="hover:text-[#F1BF0A] transition-colors">Profil Perusahaan</a></li>
                <li><a href="#" class="hover:text-[#F1BF0A] transition-colors">Karir</a></li>
                <li><a href="#" class="hover:text-[#F1BF0A] transition-colors">Blog</a></li>
                <li><a href="#" class="hover:text-[#F1BF0A] transition-colors">Hubungi Kami</a></li>
            </ul>
        </div>
        <div>
            <h5 class="text-sm/4 font-bold mb-4">Bantuan</h5>
            <ul class="space-y-2.5 text-xs/4 text-white/60">
                <li><a href="#" class="hover:text-[#F1BF0A] transition-colors">Cara Pesan</a></li>
                <li><a href="#" class="hover:text-[#F1BF0A] transition-colors">Lacak Pesanan</a></li>
