                <span class="font-anton text-xl text-[#183fad] opacity-30">EPSON</span>
                <span class="font-anton text-xl text-[#183fad] opacity-30">Cheil</span>
                <span class="font-anton text-xl text-[#183fad] opacity-30">ASTRA</span>
